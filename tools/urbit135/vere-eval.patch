diff --git a/tests/eval-kernel-formula.py b/tests/eval-kernel-formula.py
new file mode 100644
index 000000000..e8955218c
--- /dev/null
+++ b/tests/eval-kernel-formula.py
@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+"""Check raw-kernel eval framing, evaluation, and failure behavior.
+
+python3 tests/eval-kernel-formula.py --urbit PATH --kernel-formula PATH --version 135
+
+The supplied kernel formula is raw jam [type nock], without a newt header.
+Its Nock formula executes against ~ to initialize the target subject.
+"""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--urbit", type=Path, required=True)
+    parser.add_argument("--kernel-formula", type=Path, required=True)
+    parser.add_argument("--compiler-formula", type=Path)
+    parser.add_argument("--version", type=int, required=True)
+    args = parser.parse_args()
+    binary = str(args.urbit.resolve())
+
+    def frame(data):
+        assert len(data) >= 6 and data[0] == 0, "missing newt result"
+        assert int.from_bytes(data[1:5], "little") == len(data) - 5, "truncated newt result"
+        return data[5:]
+
+    def builtin(source):
+        # The built-in evaluator sends newt through libuv. A regular file keeps
+        # that independent reference from exiting with a queued pipe write.
+        with tempfile.TemporaryFile() as output:
+            result = subprocess.run([binary, "eval", "-j", "-n"], input=source.encode(),
+                                    stdout=output, stderr=subprocess.PIPE, timeout=60)
+            assert result.returncode == 0, result.stderr.decode(errors="replace")
+            output.seek(0)
+            data = output.read()
+            frame(data)
+            return data
+
+    with tempfile.TemporaryDirectory() as directory:
+        directory = Path(directory)
+        kernel = args.kernel_formula
+
+        def evaluate(source, path=kernel, flags=("-j", "-n"), timeout=60, compiler=args.compiler_formula):
+            compiler_args = ["--compiler-formula", str(compiler)] if compiler else []
+            return subprocess.run([binary, "eval", "--kernel-formula", str(path), *compiler_args, *flags],
+                                  input=source.encode(), stdout=subprocess.PIPE,
+                                  stderr=subprocess.PIPE, timeout=timeout)
+
+        started = time.monotonic()
+        for source, reference in [
+            ("hoon-version", str(args.version)),
+            ("(add 2 3)", "5"),
+            ("(mul 17 19)", "323"),
+            ("[1 2 3]", "[1 2 3]"),
+            ("(ream '1')", "(ream '1')"),
+            ('~>(%slog.[0 %leaf "message"] 42)', "42"),
+            ("\'" + "a" * 70000 + "\'", "\'" + "a" * 70000 + "\'"),
+        ]:
+            result = evaluate(source)
+            assert result.returncode == 0, f"{source}: {result.stderr.decode(errors='replace')}"
+            frame(result.stdout)
+            assert result.stdout == builtin(reference), f"incorrect result: {source}"
+
+        result = evaluate('~>(%slog.[0 %leaf "oracle-stage"] 42)')
+        assert result.returncode == 0 and result.stdout == builtin("42")
+        assert b"oracle-stage" in result.stderr, result.stderr
+        result = evaluate('(~(mute vi |) |.(~>(%slog.[0 %leaf "virtual-stage"] 42)))')
+        assert result.returncode == 0 and result.stdout == builtin("[0 42]")
+        assert b"virtual-stage" in result.stderr, result.stderr
+
+        for source in ["!!", "|=", "no-such-eval-arm", "42\0!!"]:
+            result = evaluate(source)
+            assert result.returncode != 0 and not result.stdout, source
+
+        for name, data in [("empty", b""), ("truncated", b"\x00"),
+                           ("atom", frame(builtin("0"))),
+                           ("bad-formula", frame(builtin("[0 0]")))]:
+            path = directory / name
+            path.write_bytes(data)
+            result = evaluate("42", path)
+            assert result.returncode != 0 and not result.stdout, name
+
+        result = evaluate("42", directory / "missing")
+        assert result.returncode != 0 and not result.stdout
+        for flags in [(), ("-j",), ("-c", "-n"), ("-j", "-n", "-c")]:
+            result = evaluate("42", flags=flags)
+            assert result.returncode != 0 and not result.stdout, flags
+
+        # The supplied compiler receives source bytes without host parsing.
+        compiler = directory / "constant-compiler.jam"
+        compiler.write_bytes(frame(builtin("(make '|=([subject=* source=@t] [0 [1 42]])')")))
+        result = evaluate("this is intentionally not Hoon", compiler=compiler)
+        assert result.returncode == 0 and result.stdout == builtin("42")
+        compiler.write_bytes(frame(builtin("(make '|=([subject=* source=@t] 42)')")))
+        result = evaluate("42", compiler=compiler)
+        assert result.returncode != 0 and not result.stdout
+        for data in [b"", b"\x00", frame(builtin("42"))]:
+            compiler.write_bytes(data)
+            result = evaluate("42", compiler=compiler)
+            assert result.returncode != 0 and not result.stdout
+        result = evaluate("42", compiler=directory / "missing-compiler")
+        assert result.returncode != 0 and not result.stdout
+        result = subprocess.run([binary, "eval", "--compiler-formula", str(compiler), "-j", "-n"],
+                                input=b"42", capture_output=True, timeout=10)
+        assert result.returncode != 0 and not result.stdout
+        if args.compiler_formula:
+            result = evaluate("(ream ';div\\0a  # A heading\\0a\\0a==\\0a')")
+            assert result.returncode == 0, result.stderr.decode(errors="replace")
+            frame(result.stdout)
+
+        sample = directory / "sample.jam"
+
+        def slam(gate, path=sample, timeout=60):
+            return evaluate(gate, flags=("-j", "-n", "--sample", str(path)), timeout=timeout)
+
+        for noun in ["0", "42", "[1 [2 3] 4]", "0x62.0061", "(bex 1.000.000)"]:
+            expected = builtin(noun)
+            sample.write_bytes(frame(expected))
+            result = slam("|=(a=* a)")
+            assert result.returncode == 0, result.stderr.decode(errors="replace")
+            frame(result.stdout)
+            assert result.stdout == expected, f"sample changes: {noun}"
+
+        # Repeated parser calls exercise shared kernel batteries in jet lookup.
+        sample.write_bytes(frame(builtin("'" + "[1 2]  " * 4000 + "'")))
+        result = slam("|=(source=@t (lent (rash source (ifix [gay gay] (most gap tall:vast)))))",
+                      timeout=10)
+        assert result.returncode == 0 and result.stdout == builtin("4.000")
+
+        sample.write_bytes(frame(builtin("41")))
+        result = slam("|=(a=@ +(a))")
+        assert result.returncode == 0 and result.stdout == builtin("42")
+        for gate in ["42", "[0 0]", "|=(a=* !!)"]:
+            result = slam(gate)
+            assert result.returncode != 0 and not result.stdout, gate
+        for invalid in [b"", b"\x00"]:
+            sample.write_bytes(invalid)
+            result = slam("|=(a=* a)")
+            assert result.returncode != 0 and not result.stdout
+        result = slam("|=(a=* a)", directory / "missing-sample")
+        assert result.returncode != 0 and not result.stdout
+        expected = builtin("[0 42]")
+        sample.write_bytes(frame(expected))
+        result = subprocess.run([binary, "eval", "--sample", str(sample), "-j", "-n"],
+                                input=b"|=(a=* a)", stdout=subprocess.PIPE,
+                                stderr=subprocess.PIPE, timeout=10)
+        assert result.returncode == 0 and result.stdout == expected
+        for flags in [(), ("-j",), ("-c", "-n")]:
+            result = subprocess.run([binary, "eval", "--sample", str(sample), *flags],
+                                    input=b"|=(a=* a)", stdout=subprocess.PIPE,
+                                    stderr=subprocess.PIPE, timeout=10)
+            assert result.returncode != 0 and not result.stdout
+
+        # Supplying a kernel formula does not change the executable's built-in subject.
+        assert builtin("(add 2 3)") == builtin("5")
+        print(f"eval kernel-formula checks pass ({time.monotonic() - started:.2f}s)")
+
+
+if __name__ == "__main__":
+    main()
