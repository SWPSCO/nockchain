+/* _cw_eval_load_jam(): load a raw jammed noun.
+*/
+static u3_noun
+_cw_eval_load_jam(const c3_c* pat_c, const c3_c* kind_c)
+{
+  FILE* fil_u = fopen(pat_c, "rb");
+  long  len_l;
+  c3_y* byt_y;
+  u3_weak vas;
+
+  if ( !fil_u ) {
+    fprintf(stderr, "eval: cannot open %s %s: %s\n", kind_c, pat_c, strerror(errno));
+    exit(1);
+  }
+  if ( fseek(fil_u, 0, SEEK_END) || (len_l = ftell(fil_u)) <= 0 ||
+       fseek(fil_u, 0, SEEK_SET) ) {
+    fprintf(stderr, "eval: cannot read %s %s\n", kind_c, pat_c);
+    fclose(fil_u);
+    exit(1);
+  }
+  byt_y = c3_malloc((size_t)len_l);
+  if ( fread(byt_y, 1, (size_t)len_l, fil_u) != (size_t)len_l ||
+       EOF != fgetc(fil_u) || ferror(fil_u) ) {
+    fprintf(stderr, "eval: cannot read complete %s %s\n", kind_c, pat_c);
+    fclose(fil_u);
+    c3_free(byt_y);
+    exit(1);
+  }
+  fclose(fil_u);
+  vas = u3s_cue_xeno((c3_d)len_l, byt_y);
+  c3_free(byt_y);
+  if ( u3_none == vas ) {
+    fprintf(stderr, "eval: invalid jammed %s %s\n", kind_c, pat_c);
+    exit(1);
+  }
+  return vas;
+}
+
+/* _cw_eval_load_formula(): load a raw jammed [type nock] kernel formula.
+*/
+static u3_noun
+_cw_eval_load_formula(const c3_c* pat_c)
+{
+  //  Share batteries with the live kernel before entering a child road.
+  //  Senior home-road nouns cannot unify during repeated jet lookups.
+  //
+  u3_noun ker = u3m_dedup(_cw_eval_load_jam(pat_c, "kernel formula"));
+  if ( c3n == u3du(ker) ) {
+    fprintf(stderr, "eval: kernel formula must be a [type nock] cell\n");
+    exit(1);
+  }
+  return ker;
+}
+
+/* _cw_eval_slam(): apply an evaluated gate to a decoded sample.
+*/
+static u3_noun
+_cw_eval_slam(u3_noun arg)
+{
+  u3_noun gat = u3k(u3h(arg));
+  u3_noun sam = u3k(u3t(arg));
+  u3z(arg);
+  return u3n_slam_on(gat, sam);
+}
+
+/* _cw_eval_with_kernel(): register a kernel and evaluate text in its subject.
+*/
+static u3_noun
+_cw_eval_with_kernel(u3_noun sam)
+{
+  u3_noun ker = u3h(sam);
+  u3_noun typ = u3k(u3h(ker));
+  u3_noun val = u3n_nock_on(u3_nul, u3k(u3t(ker)));
+  u3_noun cop = u3k(u3h(u3t(sam)));
+  u3_noun txt = u3k(u3t(u3t(sam)));
+  u3_noun gat;
+  u3z(sam);
+
+  if ( c3y == u3du(cop) ) {
+    u3_noun out, fol;
+
+    //  The compiler gate runs in the initialized kernel. Its sample contains
+    //  the raw subject type and source; the built-in compiler sees neither.
+    //
+    gat = u3n_nock_on(u3k(val), u3k(u3t(cop)));
+    u3z(cop);
+    out = u3n_slam_on(gat, u3nc(typ, txt));
+    if ( c3n == u3du(out) ) {
+      return u3m_bail(c3__exit);
+    }
+    fol = u3k(u3t(out));
+    u3z(out);
+    return u3n_nock_on(val, fol);
+  }
+  u3z(cop);
+
+  //  Compile the expression with the built-in compiler against the supplied
+  //  subject. Calls such as (ream text) select that subject's standard library.
+  //
+  gat = u3v_wish("|=([env=vase text=@t] +:(slap env (ream text)))");
+  return u3n_slam_on(gat, u3nc(u3nc(typ, val), txt));
+}
+
+/* _cw_eval_write_newt(): complete a synchronous evaluator result frame.
+*/
+static void
+_cw_eval_write_newt(c3_d len_d, const c3_y* byt_y)
+{
+#ifdef U3_OS_windows
+  if ( -1 == _setmode(_fileno(stdout), _O_BINARY) ) {
+    fprintf(stderr, "eval: cannot configure binary stdout\n");
+    exit(1);
+  }
+#endif
+  c3_y hed_y[5] = {0, len_d & 0xff, (len_d >> 8) & 0xff,
+                  (len_d >> 16) & 0xff, (len_d >> 24) & 0xff};
+  if ( len_d > 0xffffffffULL ||
+       fwrite(hed_y, 1, sizeof(hed_y), stdout) != sizeof(hed_y) ||
+       fwrite(byt_y, 1, (size_t)len_d, stdout) != (size_t)len_d ||
+       fflush(stdout) ) {
+    fprintf(stderr, "eval: cannot write complete newt result\n");
+    exit(1);
+  }
+}
+
+/* _cw_eval_slog(): print evaluator diagnostics to stderr.
+*/
+static void
+_cw_eval_slog(u3_noun hod)
+{
+  u3_pier_tank(0, 0, u3k(u3t(hod)));
+  u3z(hod);
+}
